# Copy to .env next to this file. Required variables are loaded at import time unless noted.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DATABASE_URL=postgresql://user:password@localhost:5432/spotify_analyzer

# Auth (panel login uses exactly 48-character passwords)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
USER1_PASSWORD=
USER2_PASSWORD=

# dev: CORS defaults to *. prod: set comma-separated origins (no *)
ENVIRONMENT=dev
# ALLOWED_ORIGINS=http://localhost:3000

# Optional: ISRC helper service (Flask licensor_lookup_server.py on port 1337)
ISRC_SERVICE_URL=http://127.0.0.1:1337/get_licensor

# Optional: Soundcharts (stream history)
SOUNDCHARTS_API_KEY=
