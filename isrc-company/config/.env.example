# Spotify Web Player session values for isrc-company (spclient metadata calls).
# Copy to .env in this directory. Do not commit .env.

# Full header value, usually "Bearer <access_token>"
SPOTIFY_WEB_AUTHORIZATION=

# Value of the client-token header from an authenticated open.spotify.com session
SPOTIFY_WEB_CLIENT_TOKEN=

# Track metadata URL template: set the real value in your local .env only (gitignored).
# Must include the literal placeholder {gid} for the hex track id.
SPOTIFY_SPCLIENT_TRACK_URL_TEMPLATE=
